# ============================================================
# OmniSurv - Root Git Ignore Configuration
# Crafted by: Cyber Synergists
# ============================================================

# Environment variables & secrets (NEVER COMMIT)
.env
.env.*
*.env
!.env.example
secrets/

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Node.js & Web Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.output/
.nitro/
.vite/
dist/
.lovable/
.wrangler/

# Databases & local storage
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal

# Large forensic images and test artifacts (Keep directory structure, ignore dumps)
evidence_storage/uploads/*
!evidence_storage/uploads/.gitkeep
evidence_storage/raw_chunks/*
!evidence_storage/raw_chunks/.gitkeep
evidence_storage/mp4_clips/*
!evidence_storage/mp4_clips/.gitkeep
evidence_storage/reports/*
!evidence_storage/reports/.gitkeep
Forensic\ Engine/evidence_storage/*
!Forensic\ Engine/evidence_storage/.gitkeep
*.dd
*.img
*.raw
*.bin
*.e01
*.h264
*.h265
*.dav
*.dhav

# OS & IDE Files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# Temporary scratch & logs
logs/
*.log
scratch/
