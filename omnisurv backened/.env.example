# ============================================================
# OmniSurv - Environment Variables Template
# Team: Cyber Synergists (SIH2026)
# ============================================================

# Database Configuration
# Default: zero-dependency SQLite (works out of the box)
# Production: postgresql+asyncpg://user:password@localhost:5432/omnisurv
DATABASE_URL=sqlite+aiosqlite:///./omnisurv.db

# Storage paths (relative or absolute)
EVIDENCE_STORAGE_PATH=evidence_storage
OMNISURV_SCAN_BUFFER_SIZE=4194304
OMNISURV_SCAN_OVERLAP=256
OMNISURV_HASH_CHUNK_SIZE=4194304

# Host & Streaming URLs
CLIP_STREAM_BASE_URL=http://localhost:8000/static/clips
OMNISURV_OPERATOR_ID=INV-001-CYBER-SYNERGISTS

# ============================================================
# Cloud AI Multimodal Engine Keys (Multi-Key Rotator Pools)
# ============================================================

# Google Gemini API - 5 Rotator Keys (comma-separated or single)
# Primary model: gemini-3.8-flash (or gemini-2.5-flash / gemini-1.5-flash)
GEMINI_API_KEY=YOUR_GEMINI_KEY_1
GEMINI_KEYS=YOUR_GEMINI_KEY_1,YOUR_GEMINI_KEY_2,YOUR_GEMINI_KEY_3,YOUR_GEMINI_KEY_4,YOUR_GEMINI_KEY_5
GEMINI_MODEL=gemini-3.8-flash

# Groq API - 10 Rotator Keys (comma-separated or single)
# Primary model: qwen/qwen3.8-27b (or llama3-8b-8192)
GROQ_API_KEY=YOUR_GROQ_KEY_1
GROQ_KEYS=YOUR_GROQ_KEY_1,YOUR_GROQ_KEY_2,YOUR_GROQ_KEY_3,YOUR_GROQ_KEY_4,YOUR_GROQ_KEY_5,YOUR_GROQ_KEY_6,YOUR_GROQ_KEY_7,YOUR_GROQ_KEY_8,YOUR_GROQ_KEY_9,YOUR_GROQ_KEY_10
GROQ_MODEL=qwen/qwen3.8-27b
